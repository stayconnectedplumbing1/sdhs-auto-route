NEXT_PUBLIC_APP_URL=http://localhost:3000

# ServiceM8 public add-on OAuth credentials.
# Do not paste these into chat. Add them to Railway Variables.
SERVICEM8_CLIENT_ID=
SERVICEM8_CLIENT_SECRET=
SERVICEM8_REDIRECT_URI=http://localhost:3000/api/servicem8/callback
SERVICEM8_SCOPES=read_customers read_jobs read_staff read_schedule write_schedule

# Required before public customer onboarding is enabled.
DATABASE_URL=
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
